# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_API_KEY=your-key-here
# Leave LLM_BASE_URL empty for OpenAI. Examples:
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama: http://localhost:11434/v1   (LLM_API_KEY can be any string)
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_VERSION=OpenAI Chat Completions API
# Published price per 1M tokens - verify on the provider's pricing page and set the date you checked.
INPUT_PRICE_PER_M=0.15
OUTPUT_PRICE_PER_M=0.60
PRICING_DATE=2026-11-01
PRICING_CURRENCY=USD
